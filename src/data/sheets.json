    {
      "id": 20,
      "number": "20",
      "greek_title": "Πῶς Δεῖ Μελετᾶν",
      "english_title": "How to Drill",
      "category": "drilling",
      "description": "Five techniques for building active fluency",
      "drills": [
        {
          "name": "Circling a Fact",
          "greek": "Α΄ · CIRCLING A FACT",
          "description": "Take one true statement and surround it with questions",
          "example": "τοῦτο βιβλίον ἐστίν. (This is a book.) → τί ἐστιν τοῦτο; → βιβλίον ἐστὶν ἢ ποτήριον;"
        },
        {
          "name": "Substitution",
          "greek": "Β΄ · SUBSTITUTION",
          "description": "Keep the frame, change one slot. Feel the endings shift in your mouth",
          "example": "ὁ Ἰησοῦς λαλεῖ. → οἱ μαθηταὶ λαλοῦσιν."
        },
        {
          "name": "Commands with the Body",
          "greek": "Δ΄ · COMMANDS WITH THE BODY",
          "description": "One person commands, others obey in silence. No translation",
          "example": "ἔγειρε · ἐλθὲ πρὸς τὴν θύραν · ἄνοιξον αὐτήν · κάθισον"
        },
        {
          "name": "Retelling a Scene",
          "greek": "Ε΄ · RETELLING A SCENE",
          "description": "Read a paragraph of Mark, close the book, answer three questions aloud",
          "prompts": [
            "τίς; (Who?)",
            "τί γίνεται; (What happens?)",
            "διὰ τί; (Why?)"
          ]
        },
        {
          "name": "Parsing Aloud",
          "greek": "ΤῸ ῬΗ͂ΜΑ ἈΝΑΛΎΕΙΝ",
          "description": "Parse verbs and nouns aloud with a fixed formula",
          "examples": [
            "ῥῆμα · χρόνος, διάθεσις, ἔγκλισις, πρόσωπον, ἀριθμός",
            "ὄνομα · γένος, ἀριθμός, πτῶσις"
          ]
        }
      ]
    }
