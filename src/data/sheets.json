        },
        {
          "greek": "τί;",
          "english": "What? Why? (neuter often means Why?)",
          "examples": [
            {"greek": "τί σοι θέλεις ποιήσω;", "english": "What do you want me to do for you?", "reference": "Mark 10:51"},
            {"greek": "τί δειλοί ἐστε; οὔπω ἔχετε πίστιν;", "english": "Why are you afraid? Have you still no faith?", "reference": "Mark 4:40"},
            {"greek": "τί ὄνομά σοι;", "english": "What is your name?", "reference": "Mark 5:9"}
