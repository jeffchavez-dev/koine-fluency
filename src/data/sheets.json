    {
      "id": 2,
      "number": "02",
      "greek_title": "Τὰ Ἐρωτηματικά Α΄",
      "english_title": "Question Words I",
      "category": "interrogatives",
      "terms": [
        {
          "greek": "τίς; τί;",
          "english": "Who? Which one? (gen. τίνος, dat. τίνι, acc. τίνα)",
          "examples": [
            {
              "greek": "τίς ἄρα οὗτός ἐστιν;",
              "english": "Who then is this?",
              "reference": "Μᾶρκ. 4:41"
            },
            {
              "greek": "ὑμεῖς δὲ τίνα με λέγετε εἶναι;",
              "english": "But you — who do you say that I am?",
              "reference": "Μᾶρκ. 8:29"
            }
          ]
        },
        {
          "greek": "πόθεν;",
          "english": "From where?",
          "examples": [
            {
              "greek": "πόθεν τούτῳ ταῦτα;",
              "english": "Where did this man get these things?",
              "reference": "Μᾶρκ. 6:2"
            }
          ]
        },
        {
          "greek": "τί;",
          "english": "What? (neuter often means Why?)",
          "examples": [
            {
              "greek": "τί σοι θέλεις ποιήσω;",
              "english": "What do you want me to do for you?",
              "reference": "Μᾶρκ. 10:51"
            }
          ]
        },
        {
          "greek": "πῶς;",
          "english": "How?",
          "examples": [
            {
              "greek": "καὶ πῶς πάσας τὰς παραβολὰς γνώσεσθε;",
              "english": "Then how will you understand all the parables?",
              "reference": "Μᾶρκ. 4:13"
            }
          ]
        },
        {
          "greek": "ποῦ;",
          "english": "Where?",
          "examples": [
            {
              "greek": "ποῦ ἐστιν τὸ κατάλυμά μου;",
              "english": "Where is my guest room?",
              "reference": "Μᾶρκ. 14:14"
            }
          ]
        },
        {
          "greek": "πότε;",
          "english": "When?",
          "examples": [
            {
              "greek": "εἰπὲ ἡμῖν πότε ταῦτα ἔσται;",
              "english": "Tell us, when will these things be?",
              "reference": "Μᾶρκ. 13:4"
            }
          ]
        },
        {
          "greek": "ποῖ;",
          "english": "To where? Whither?",
          "examples": [
            {
              "greek": "ποῦ θέλεις ἀπελθόντες ἑτοιμάσωμεν;",
              "english": "Where do you want us to go and prepare?",
              "reference": "Μᾶρκ. 14:12"
            }
          ]
        },
        {
          "greek": "διὰ τί;",
          "english": "Why? For what reason?",
          "examples": [
            {
              "greek": "διὰ τί οἱ μαθηταὶ Ἰωάννου νηστεύουσιν;",
              "english": "Why do John's disciples fast?",
              "reference": "Various"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "number": "03",
      "greek_title": "Τὰ Ἐρωτηματικά Β΄",
      "english_title": "Question Words II",
      "category": "interrogatives",
      "description": "Interrogatives that decline like adjectives",
      "terms": [
        {
          "greek": "ποῖος, -α, -ον;",
          "english": "Of what kind? Which?",
          "examples": [
            {
              "greek": "ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιεῖς;",
              "english": "By what authority are you doing these things?",
              "reference": "Μᾶρκ. 11:28"
            }
          ]
        },
        {
          "greek": "πόσος, -η, -ον;",
          "english": "How much? How many?",
          "examples": [
            {
              "greek": "πόσους ἄρτους ἔχετε;",
              "english": "How many loaves do you have?",
              "reference": "Μᾶρκ. 6:38"
            }
          ]
        },
        {
          "greek": "ποσάκις;",
          "english": "How often? How many times?",
          "examples": [
            {
              "greek": "ποσάκις ἁμαρτήσει εἰς ἐμὲ ὁ ἀδελφός μου;",
              "english": "How often shall my brother sin against me?",
              "reference": "Ματθ. 18:21"
            }
          ]
        },
        {
          "greek": "πηλίκος, -η, -ον;",
          "english": "How big? How great?",
          "examples": [
            {
              "greek": "ἴδετε πηλίκοις ὑμῖν γράμμασιν ἔγραψα;",
              "english": "See with what large letters I have written to you!",
              "reference": "Γαλ. 6:11"
            }
          ]
        }
      ]
    },
